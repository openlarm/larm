repository-code: "https://github.com/openlarm/larm"
url: "https://openlarm.org"
version: 0.1.0-alpha
date-released: "2026-04-20"
keywords:
  - drone
  - uav
  - risk model
  - flight safety
  - decision support
  - SORA 2.5
  - low altitude operations
  - subtropical climate

