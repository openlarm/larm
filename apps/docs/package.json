{
  "name": "@openlarm/docs",
  "version": "0.0.0",
  "private": true,
  "description": "LARM documentation site (docs.openlarm.org) — Nextra + Next.js.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run docs:api && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc",
    "docs:api:clean": "rm -rf public/api-reference"
  },
  "dependencies": {
    "next": "^14.2.0",
    "nextra": "^3.3.0",
    "nextra-theme-docs": "^3.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@openlarm/core": "*",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typedoc": "^0.28.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
